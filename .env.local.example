# Copy this file to .env.local and fill in real values.
# Get the Supabase ones from your project: Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Only needed in production if NEXT_PUBLIC_SITE_URL differs from the request
# host Vercel sees (usually you don't need to set this).
# NEXT_PUBLIC_SITE_URL=https://app.schela.ai

# Phase 2 (AI Orchestration) — required for the AI pipeline (classification,
# reply drafting, tool-calling) to work. Get a key at console.groq.com.
GROQ_API_KEY=gsk_...

# Real Meta WhatsApp Business Cloud API — required for WhatsApp send/receive
# to actually work, not just simulate. From a Meta App with the WhatsApp
# product added: developers.facebook.com/apps → your app → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_ACCESS_TOKEN=...
# Any string you choose yourself — enter the SAME value here and in the
# Meta App's webhook configuration screen when you register the webhook URL.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-any-random-string

# Email provider (Resend) — handles both sending and receiving.
# RECOMMENDED: set this to one shared Resend API key so every recruiter gets
# working email without creating an account or pasting a key themselves.
# A per-org key connected in Settings → Integrations takes priority over this.
RESEND_API_KEY=re_...

# Sender identity for outgoing email. EMAIL_FROM_ADDRESS is REQUIRED for email
# to send at all — it must be on a domain you've verified in Resend, or Resend
# rejects every message. A recruiter can override these per-org in
# Settings → Channels, but these env values make email work out of the box.
EMAIL_FROM_ADDRESS=interviews@yourdomain.com
EMAIL_FROM_NAME=Schela
# Where candidate replies go. Point this at your Resend inbound address so
# replies reach the /api/webhooks/email webhook.
EMAIL_REPLY_TO=recruiter@schela.app

# Real Outlook Calendar / Zoom connect flows (Settings → Integrations). Each
# is optional — until its client id/secret are set, that provider's "Connect"
# button stays disabled with an honest "not configured" message rather than
# doing nothing. Redirect URIs to register with each provider are
# {NEXT_PUBLIC_SITE_URL}/api/integrations/oauth/{outlook|zoom}/callback.
#
# Google Calendar is intentionally not offered — its OAuth verification
# requires an app review (demo video, Limited Use questionnaire, review
# queue) disproportionate to what it added over Outlook + Zoom. See SETUP.md
# section 11.
# CALENDLY_CLIENT_ID=...
# CALENDLY_CLIENT_SECRET=...

# Verifies Calendly webhooks (a candidate booking/canceling through a
# Calendly link) actually came from Calendly. Shown ONCE when the OAuth app
# itself is created in Calendly's developer portal — copy it immediately, the
# same as every other "shown once" secret in this file. It's a property of
# the OAuth app, not per-org, so this is a single deployment-wide value.
# CALENDLY_WEBHOOK_SIGNING_KEY=...

# Azure AD (Microsoft Entra) → App registrations.
# MS_CLIENT_ID=...
# MS_CLIENT_SECRET=...

# Zoom Marketplace → Build App → OAuth.
# ZOOM_CLIENT_ID=...
# ZOOM_CLIENT_SECRET=...

# Verifies inbound email webhooks actually came from Resend (not forged).
# Resend dashboard → Webhooks → your endpoint → shows this after creation.
# Without it, the endpoint logs a loud warning and accepts unsigned requests
# — fine for a first local test, not for production.
RESEND_WEBHOOK_SECRET=whsec_...

# Protects the /api/cron/reminders endpoint (24h + 1h interview reminders).
# Any random string. Send it as an "Authorization: Bearer <value>" header from
# whichever scheduler you point at that endpoint — see SETUP.md section 13.
CRON_SECRET=choose-any-random-string
